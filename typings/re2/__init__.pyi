# Type stub for the parts of google-re2 Hisaab uses (the package ships no type information).
from collections.abc import Callable

class error(Exception): ...

class Options:
    log_errors: bool
    def __init__(self) -> None: ...

class _Match:
    def group(self, index: int | str = 0, /) -> str | None: ...
    def groupdict(self) -> dict[str, str | None]: ...
    def start(self, index: int | str = 0, /) -> int: ...
    def end(self, index: int | str = 0, /) -> int: ...

class _Regexp:
    pattern: str
    groups: int
    groupindex: dict[str, int]
    def search(self, text: str, pos: int = ..., endpos: int = ...) -> _Match | None: ...
    def match(self, text: str, pos: int = ..., endpos: int = ...) -> _Match | None: ...
    def fullmatch(self, text: str, pos: int = ..., endpos: int = ...) -> _Match | None: ...
    def sub(self, repl: str | Callable[[_Match], str], text: str, count: int = 0) -> str: ...

def compile(pattern: str, options: Options | None = None) -> _Regexp: ...
def escape(pattern: str) -> str: ...
