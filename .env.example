# Copy to .env (gitignored) and fill in. Read by hisaab.config.Settings only.
# NEVER export any of these from a shell profile, rc file or setup script.

# Must be on the Linux filesystem (ext4), never under /mnt/c. Relative = project root.
HISAAB_DATABASE_PATH=data/hisaab.db
HISAAB_HOST=0.0.0.0
HISAAB_PORT=8765
# Built frontend served by the app. Relative = project root.
HISAAB_FRONTEND_DIST=frontend/dist

# Prefixed on purpose: a bare ANTHROPIC_API_KEY is picked up by Claude Code.
HISAAB_ANTHROPIC_API_KEY=
# Tier-2 email extraction: any server speaking the Anthropic Messages API, and the model to ask.
HISAAB_LLM_BASE_URL=https://api.anthropic.com
HISAAB_EMAIL_MODEL=claude-haiku-5-5
HISAAB_GOOGLE_OAUTH_CLIENT_ID=
HISAAB_GOOGLE_OAUTH_CLIENT_SECRET=
# Protects Gmail refresh tokens and account numbers at rest; kept out of the DB.
HISAAB_ENCRYPTION_KEY=
HISAAB_SESSION_SECRET=
