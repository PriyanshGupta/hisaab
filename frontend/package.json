{
  "name": "hisaab-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "gen:api": "cd .. && .venv/bin/python -m hisaab export-openapi frontend/openapi.json && cd frontend && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run gen:api && tsc -b && vite build",
    "pretest": "npm run gen:api",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/anek-latin": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
